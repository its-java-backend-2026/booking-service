<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>it.its.cinema</groupId>
	<artifactId>booking-service</artifactId>
	<version>1.0.0</version>
	<name>booking-service</name>
	<description>Prenotazioni e coordinamento della saga di acquisto.</description>

	<properties>
		<java.version>21</java.version>
		<springdoc.version>3.1.0</springdoc.version>
		<!-- PASSO 7.1 — il release train di Spring Cloud.
		     NON si sceglie a caso: ogni release train e' compilato contro una
		     riga precisa di Spring Boot, e accoppiarne due che non si parlano
		     produce NoSuchMethodError all'avvio invece di un errore di
		     compilazione. E' la trappola piu' costosa dell'aggiungere Spring
		     Cloud a un progetto: la versione la detta Boot, non noi. -->
		<spring-cloud.version>2025.1.3</spring-cloud.version>
	</properties>

	<!--
	  PASSO 7.1 — IL BOM DI SPRING CLOUD.

	  Importato con scope=import e type=pom: non aggiunge NIENTE al progetto,
	  decide soltanto CHE VERSIONE avranno gli artefatti di Spring Cloud che
	  dichiariamo sotto. E' il motivo per cui le due dipendenze del passo 7.1
	  non hanno un <version>: se ce l'avessero, prima o poi una resterebbe
	  indietro rispetto all'altra e il disallineamento si scoprirebbe in
	  esercizio.
	-->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
		  PASSO 6.5 — ATTENZIONE BOOT 4, ED E' L'ERRORE CHE FERMA TUTTI.

		  In Boot 3 l'auto-configurazione di RestClient.Builder arrivava con
		  spring-boot-starter-web. In Boot 4 e' stata spostata in un modulo
		  suo, e senza questa dipendenza l'avvio fallisce con

		      No qualifying bean of type 'org.springframework.web.client.RestClient$Builder'

		  che non nomina nessuna dipendenza mancante e manda a cercare nel
		  posto sbagliato.

		  Serve anche dal G9: e' questo modulo a portare la strumentazione che
		  propaga il traceId sulle chiamate uscenti.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
		  ========================================================================
		  PASSO 7.1 — LA RESILIENZA, E PERCHE' STA SOLO QUI.

		  booking-service e' l'unico dei tre che CHIAMA gli altri: e' l'unico che
		  puo' subire il guasto di qualcun altro. shows-service e pricing-service
		  non chiamano nessuno, e un circuit breaker li' non avrebbe niente da
		  sorvegliare.

		  Due artefatti e non uno, perche' fanno due cose diverse:

		    spring-cloud-starter-circuitbreaker-resilience4j
		        l'astrazione di Spring Cloud piu' l'auto-configurazione che
		        legge il blocco "resilience4j:" di application.yaml e registra
		        i breaker in Actuator.

		    resilience4j-spring-boot3
		        gli ASPETTI, cioe' cio' che fa funzionare le annotazioni
		        @CircuitBreaker e @Retry del passo 7.4. Senza, le annotazioni
		        si scrivono, compilano, e non fanno assolutamente niente: il
		        guasto piu' silenzioso di tutta la giornata.
		  ========================================================================
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot3</artifactId>
		</dependency>

		<!-- PASSO 6.2 — booking-service ha IL SUO database, booking_db.
		     Non uno schema dentro shows_db: un database separato, che nessun
		     altro servizio puo' leggere. E' la regola che rende possibile
		     cambiare questa tabella senza chiedere permesso a nessuno. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Le classi *IT le esegue failsafe su "mvn verify", non surefire
			     su "mvn test": cosi' "mvn test" resta veloce e non pretende
			     Docker acceso. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
